# Optional CORS-enabled HTTPS URL to a boat GLB.
# GitHub website "Add file" is 25 MB — use a Release asset instead, e.g.
# https://github.com/Dannypeja/learn-sailing/releases/download/models-v1/yacht.glb
# Leave empty to use public/models/monohull-sloop-single-rudder.glb (Kenney).
NEXT_PUBLIC_BOAT_MODEL_URL=

# Keep the hosted GLB's own materials (MesXwi yacht). Defaults to true when a
# hosted URL is set. Set false to force the Kenney gelcoat override.
NEXT_PUBLIC_BOAT_PRESERVE_MATERIALS=
